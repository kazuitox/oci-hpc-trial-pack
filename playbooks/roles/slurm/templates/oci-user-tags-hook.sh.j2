#!/bin/sh
# Only this accounting hook is best effort. Slurm still handles other prologs'
# return codes, including healthchecks and Pyxis, independently.
/usr/bin/timeout --kill-after=1s 3s /usr/local/sbin/slurm-oci-user-tags {{ item }} --config {{ (slurm_conf_path ~ '/oci-user-tags.json') | quote }}
status=$?
if [ "$status" -ne 0 ]; then
    printf 'Slurm user tag {{ item }} deferred (status=%s)\n' "$status" >&2
fi
exit 0
