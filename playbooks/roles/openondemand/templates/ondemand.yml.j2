# /etc/ood/config/ondemand.d/ondemand.yml
---
dashboard_title: "OOD CONFIG TEST"

# Applies to the standard directory preflight used by ZIP and direct downloads.
download_dir_timeout_seconds: {{ ood_download_dir_timeout_seconds | default(300) | int }}

pinned_apps:
  - 'sys/files'
  - 'sys/bc_desktop'
  - 'sys/shell'
  - 'sys/OpenComposer'
  - 'sys/OpenComposerHistory'
  - 'sys/system-status'
{% if ood_dcv_enabled | bool %}
  - 'sys/dcv'
{% endif %}

pinned_apps_menu_length: 15
pinned_apps_group_by: category

dashboard_layout:
  rows:
    - columns:
        - width: 12
          widgets:
            - pinned_apps

custom_pages:
  opencomposer_slurm:
    rows:
      - columns:
          - width: 12
            widgets:
              - opencomposer_slurm
  opencomposer_history:
    rows:
      - columns:
          - width: 12
            widgets:
              - opencomposer_history
